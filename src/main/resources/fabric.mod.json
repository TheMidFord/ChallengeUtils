{
	"schemaVersion": 1,
	"id": "challengeutils",
	"version": "${version}",
	"name": "Challenge Utils",
	"description": "This mod adds stuff for BTA! challenge modpacks.",
	"authors": [
		"Malice Development"
	],
	"contact": {
		"homepage": "https://www.github.com/TheMidford/ChallengeUtils",
		"discord": "@themidford",
		"sources": ""
	},
	"icon": "icon.png",
	"license": "CC0-1.0",
	"environment": "*",
	"entrypoints": {
		"main": [
          "malicedev.challengeutils.Main"
		],
		"beforeGameStart": [
          "malicedev.challengeutils.Main"
		],
		"afterGameStart": [
          "malicedev.challengeutils.Main"
		],
		"recipesReady": [
          "malicedev.challengeutils.Main"
		],
		"initModels": [
			"malicedev.challengeutils.ModModels"
		],
		"client": [
			"malicedev.challengeutils.ChallengeUtilsClient"
		]
	},
	"mixins": [
		"challengeutils.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabricloader}",
		"halplibe": ">=${halplibe}",
		"minecraft": "*",
		"java": ">=${java}"
	},
	"suggests": {
		"modmenu": ">=${modmenu}"
	}
}
